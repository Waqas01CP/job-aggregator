{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["tools/heredoc_guard.py"],
            "timeout": 10,
            "statusMessage": "Checking the heredoc"
          }
        ]
      }
    ]
  }
}
