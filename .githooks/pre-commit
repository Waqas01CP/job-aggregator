#!/usr/bin/env bash
# Pre-commit gate. Enable once per clone:
#
#   git config core.hooksPath .githooks
#
# Six checks, every one of which must be able to fail. Prove each by
# giving it the case built to defeat it before trusting it. A gate nobody
# has seen fire is indistinguishable from an absent one, and worse,
# because it is trusted.

set -e

fail() {
  echo ""
  echo "COMMIT BLOCKED: $1"
  echo ""
  exit 1
}

# ---------------------------------------------------------------------
# 1. Raw payloads must never reach this repository. ADR-0011.
#
# .gitignore already excludes these extensions, but an explicit
# "git add -f" bypasses it. This does not.
# ---------------------------------------------------------------------

staged=$(git diff --cached --name-only --diff-filter=ACM)

for file in $staged; do
  case "$file" in
    *.html|*.eml|*.har)
      fail "raw payload file staged: $file
       ADR-0011 keeps employer description text out of this repository."
      ;;
  esac
done

# ---------------------------------------------------------------------
# 2. Cassettes must be sanitised. ADR-0017.
#
# A committed cassette carries a real board response. Description fields
# are stripped and replaced with a fixed placeholder before commit.
# ---------------------------------------------------------------------

for file in $staged; do
  case "$file" in
    tests/cassettes/*)
      if grep -qiE '"(description|content|job_description|body)"[[:space:]]*:[[:space:]]*"' "$file" 2>/dev/null; then
        if ! grep -q 'STRIPPED' "$file" 2>/dev/null; then
          fail "unsanitised cassette staged: $file
       Strip description fields and replace each with the STRIPPED
       placeholder. ADR-0017."
        fi
      fi
      ;;
  esac
done

# ---------------------------------------------------------------------
# 3. No Obsidian wikilinks. This repository is public.
#
# [[Some File]] renders as literal text on GitHub, points at a file that
# is not in the repository, and leaks the operator's private vault
# filenames. Seven of these were found and removed by hand; this gate
# exists because a hand sweep cannot prove it found them all.
# ---------------------------------------------------------------------

for file in $staged; do
  case "$file" in
    *.md)
      if grep -qE '\[\[[^]]+\]\]' "$file" 2>/dev/null; then
        fail "Obsidian wikilink staged in: $file
       This repository is public. State the substance inline, or use a
       relative markdown link to a file that is actually in the repo."
      fi
      ;;
  esac
done

# ---------------------------------------------------------------------
# 4. STATE.md must move when implementation work moves.
#
# STATE.md is the only hand-written artifact in this repository with no
# generator behind it, which makes it the one most able to lie. ADR-0023
# requires it to be updated in the same commit as the work, never in a
# separate bookkeeping pass. A bookkeeping pass is a pass that gets
# skipped.
#
# Scoped to implementation paths on purpose. A typo fix in a decision
# record does not change what is built, and a gate that fires on every
# commit is a gate people learn to bypass.
# ---------------------------------------------------------------------

touched_impl=0
for file in $staged; do
  case "$file" in
    src/*|tools/*.py|.github/workflows/*)
      touched_impl=1
      ;;
    logs/*)
      if [ "$file" != "logs/README.md" ]; then
        touched_impl=1
      fi
      ;;
  esac
done

if [ "$touched_impl" -eq 1 ]; then
  if ! echo "$staged" | grep -qx 'STATE.md'; then
    fail "implementation work is staged but STATE.md is not.
       ADR-0023: STATE.md is updated in the same commit as the work.
       Update the affected rows and the verified-against line, stage
       STATE.md, and commit again."
  fi
fi

# No stamp may claim a time that has not happened. The verified-against line
# was stamped ahead of the commit three times on 2026-09-23, each an
# estimate written instead of running date -u, and fixing it once by hand
# did not stop the next. This gate first read only the first "Last
# verified" line, so on 2026-09-24 a "Touched" line in STATE.md and a note
# in a log both carried a future stamp past it. It now reads every UTC
# stamp in a staged STATE.md or log, to the minute or with seconds and a
# fraction, each cut to the minute before it is compared; the audit of
# 2026-09-25 found the seconds form passing (nit 2). Compared as UTC text,
# which sorts as time. A time with no date cannot be judged and is not
# read. The `|| true` keeps set -e from ending the hook when a file has no
# stamp.
now=$(date -u +%Y-%m-%dT%H:%MZ)
for file in $staged; do
  case "$file" in
    STATE.md|logs/*.md) ;;
    *) continue ;;
  esac
  latest=$(git show ":$file" \
    | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\.[0-9]+)?)?Z' \
    | cut -c1-16 | sed 's/$/Z/' | sort | tail -1 || true)
  if [ -n "$latest" ] && [[ "$latest" > "$now" ]]; then
    fail "$file carries the stamp $latest, but it is now $now UTC.
       Nothing written down can be later than the commit that records it.
       Run date -u and stamp what it prints."
  fi
done

# ---------------------------------------------------------------------
# 5. The map must not be stale. It is generated, not written.
#
# This is the gate that makes the same-operation rule real. Without it
# the rule is advice, and advice about updating an index is the advice
# most reliably forgotten.
#
# Python is resolved by RUNNING it, not by command -v. On Windows,
# command -v matches the App Execution Alias stub in WindowsApps, which
# exits non-zero without executing anything. An earlier version of this
# hook read that as "map is stale" and announced a cause it had not
# tested. Worse, had the stub exited zero, the gate would have passed
# while checking nothing.
#
# A missing Python is a hard failure, never a skip. A check that is
# silently skipped is indistinguishable from a check that passed.
# ---------------------------------------------------------------------

PY=""
for candidate in python3 python py; do
  if command -v "$candidate" >/dev/null 2>&1; then
    if "$candidate" -c "import sys; sys.exit(0)" >/dev/null 2>&1; then
      PY="$candidate"
      break
    fi
  fi
done

if [ -z "$PY" ]; then
  fail "no working Python found, so MAP.md could not be verified.
       Tried python3, python, py. On Windows, 'python' may resolve to the
       Microsoft Store alias stub, which is not a Python.
       Install Python or put a real one on the PATH that git hooks see.
       This is a hard failure on purpose: a skipped check is not a check."
fi

set +e
"$PY" tools/generate_map.py --check
map_status=$?
set -e

case "$map_status" in
  0)
    ;;
  2)
    fail "MAP.md is stale or missing.
       Run: $PY tools/generate_map.py
       Then stage MAP.md and commit again."
    ;;
  *)
    fail "the map check failed for a reason other than staleness.
       Its output is above. Fix that, do not regenerate blindly."
    ;;
esac

# ---------------------------------------------------------------------
# 6. Nothing the pipeline writes belongs on a code branch. ADR-0020.
#
# ADR-0020 promised "a guard rejecting an aggregator-sourced file from a
# commit", and for two weeks there was none. The guard that matters most
# could never be a hook: the data branch's commits are built with
# git commit-tree, which runs no hooks at all. That one lives in the
# run's commit step and reads every record's source.
#
# This gate covers the other failure mode, which a hook can see: a
# working file staged onto a code branch by hand. .gitignore excludes
# data/, so reaching here takes an explicit "git add -f", which is
# exactly the act that needs stopping. An aggregator's rows staged this
# way would be published against the terms ADR-0020 exists to honour,
# and the raw layer would be committed twice in two different shapes.
# ---------------------------------------------------------------------

for file in $staged; do
  case "$file" in
    data/*)
      fail "a pipeline working file is staged: $file
       ADR-0020 and ADR-0033: data/ holds working copies. The store is
       the orphan data branch, written by the run itself. Aggregator
       rows under data/local/ and data/fetch-all-local/ must never be
       published at all.
       If you reached here with 'git add -f', that is the act this gate
       exists to stop. Unstage it: git restore --staged $file"
      ;;
  esac
done

exit 0
