# Secrets. Never commit any of these.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# Raw third-party payloads. ADR-0011 keeps description text out of this
# repository entirely. Sanitised cassettes under tests/cassettes/ are
# deliberately NOT ignored: they must be committed so tests run in a
# clean checkout. See ADR-0017.
*.html
*.eml
*.har
payloads/
raw_responses/

# Pipeline data. Lives on the data branch or locally, never on main.
# ADR-0002 and ADR-0020.
data/
*.jsonl

# The layers the run writes. These live on the orphan data branch, which is
# never checked out, so on main they are working files and never committed.
filtered.json
seen.json
logs-runs/

# A TEST_MODE run writes the same shapes beside production data.
test-fetch-all/
test-filtered.json
test-seen.json
test-logs-runs/

# Aggregator-sourced raw files. ADR-0020 keeps these off the public
# repository entirely, because Jobicy and Remotive prohibit
# redistribution and a branch inherits its repository's visibility.
# One file per source, so provenance is the filename and no routing
# bug can misfile a row into a published branch.
fetch-all/

# Commit message drafts. Local scratch, never committed.
.commitmsg/

# Architecture chat tracking. Local to the operator's chat sessions, not
# part of the project record. STATE.md is the project's state; this is the
# conversation's.
CHAT_STATE.md

# Generated map output, before it is compared. The committed MAP.md is
# checked in; this is the scratch file the pre-commit hook writes.
MAP.generated.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Obsidian, in case the vault convention leaks in
.obsidian/
