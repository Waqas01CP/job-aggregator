# Copy to .env for a local run and fill in the values. .env is gitignored and
# must never be committed. Variables already set in the environment win over
# this file, so a GitHub run, which receives these as repository secrets, is
# unaffected by it.

AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
AIRTABLE_TEST_TABLE_ID=
AGGREGATOR_STORE_TOKEN=
AGGREGATOR_STORE_REPO=
